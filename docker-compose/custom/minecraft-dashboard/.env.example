# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# Loaded via `env_file:` in ../../gaming/minecraft/docker-compose.yml.
#
# RCON_PASSWORD is NOT set here. It is shared with the minecraft service itself,
# so it lives in ../../gaming/minecraft/.env and compose substitutes it into both
# services. Setting it here would have no effect.

PORT=3070
RCON_HOST=minecraft
RCON_PORT=25575
LOG_PATH=/data/logs/latest.log

# Leave empty to show the "map not configured" placeholder.
# Set to the BlueMap web UI address (e.g. http://homeserver:8100/) to embed it.
BLUEMAP_URL=
