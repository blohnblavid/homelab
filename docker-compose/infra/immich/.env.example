# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# All supported variables: https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=pgdata

TZ=America/Chicago

# The Immich version to use. Pin to a major (e.g. "v3") or an exact release.
IMMICH_VERSION=v3

# Connection secret for postgres. Use only the characters `A-Za-z0-9`.
DB_PASSWORD=CHANGE_ME

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
