# Copy to .env (gitignored) and fill in. Real shell env vars override these.

# --- required ---
GROQ_API_KEY=
WAZUH_PASS=

# --- optional (defaults shown) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_USER=admin
NETDATA_URL=http://localhost:19999
WAZUH_WINDOW=now-24h
# Groq model for routing and answers. Needs tool-calling support for questions that
# match no keyword; without it those questions only get the overview.
GROQ_MODEL=openai/gpt-oss-20b
